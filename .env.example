# Copy the keys you need into the deployment's environment (Lovable Cloud →
# project settings → secrets). `.env` here holds only the public Supabase
# values; everything below is server-side and must never reach the browser.

# --- Supabase ---------------------------------------------------------------
# Public values live in .env already. The service-role key is server-only and
# is what every waitlist read and write runs under.
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_…"

# --- Waitlist email ---------------------------------------------------------
# Issued with the Lovable project; sends mail and signs the delivery webhook.
LOVABLE_API_KEY="lv_…"

# The From header. The address must be on a domain verified for sending.
WAITLIST_FROM_NAME="InfinityID Labs"
WAITLIST_FROM_ADDRESS="updates@notify.infinityid.labs"
# Defaults to the domain of WAITLIST_FROM_ADDRESS. Set it when they differ.
WAITLIST_SENDER_DOMAIN="notify.infinityid.labs"
# Optional: where replies go, if not the From address.
WAITLIST_REPLY_TO="hello@infinityid.labs"
# Shown in the footer of bulk mail. Most jurisdictions expect a postal address.
WAITLIST_POSTAL_ADDRESS="InfinityID Labs, 1 Example Street, City, Country"

# Absolute origin used to build confirmation and unsubscribe links.
SITE_URL="https://infinityid.labs"

# Gate for /studio/waitlist. Long random string, rotatable on its own:
#   openssl rand -hex 32
WAITLIST_ADMIN_TOKEN=""

# Set to 1 to log sends instead of making them — useful locally.
WAITLIST_EMAIL_DRY_RUN="0"

# --- HoloDock presale (Stripe) ----------------------------------------------
# Server-side only. Start with test keys (sk_test_…) and card 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint at <SITE_URL>/api/stripe/webhook, subscribed to:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Prices are minor units (pence): 29900 = £299. An edition with no price shows
# "Price announced soon" and only takes deposits.
PRESALE_PRICE_DEVKIT=
PRESALE_PRICE_STANDARD=
# Refundable deposit per unit, counted towards the price. Defaults to 4900 (£49).
DEPOSIT_AMOUNT=4900
DEPOSIT_CURRENCY=gbp
# Countries Stripe may ship full pre-orders to.
PRESALE_SHIP_COUNTRIES=GB

# Optional: mirror buyers into HubSpot. Private-app token with
# crm.objects.contacts.read/write and crm.schemas.contacts.write; run
# `npm run hubspot:setup` once to create the holodock_* properties.
HUBSPOT_ACCESS_TOKEN=
